# Production site URL (used for Open Graph / social sharing absolute URLs)
# Example: https://www.ikigaihospitals.com
VITE_SITE_URL=

# TeleCRM Sync API (do not commit real tokens)
# Docs: https://docs.telecrm.in/sync-api/overview
# Create lead: POST https://next.telecrm.in/autoupdate/v2/enterprise/{enterpriseId}/lead
# One-time display string looks like: {enterpriseUUID}{timestamp}:{tokenUUID}
# VITE_TELECRM_ENTERPRISE_ID = the leading UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# VITE_TELECRM_TOKEN = remaining {timestamp}:{tokenUUID} after stripping that UUID
# Token type must be Sync (Async tokens are rejected with 401 NOT_AUTHORIZED)
VITE_TELECRM_ENTERPRISE_ID=
VITE_TELECRM_TOKEN=

# Instagram Graph API (optional — for dynamic reel fetching; not currently wired)
# Requires a Meta app, Instagram Business account, and long-lived access token.
# VITE_INSTAGRAM_ACCESS_TOKEN=
# VITE_INSTAGRAM_USER_ID=
